{
  "expo": {
    "name": "Sillage",
    "slug": "sillage",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FAF8F5",
    "scheme": "sillage",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sillage.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Autoriser Sillage à utiliser votre appareil photo pour scanner les flacons de parfum.",
        "NSPhotoLibraryUsageDescription": "Autoriser Sillage à accéder à votre photothèque pour télécharger des photos de parfum.",
        "NSMicrophoneUsageDescription": "Autoriser Sillage à utiliser le micro pour rechercher des parfums à la voix.",
        "NSLocationWhenInUseUsageDescription": "Sillage utilise ta position pour afficher la météo locale et suggérer des parfums adaptés à la saison.",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.831514606817-tjenh1vpj086jsho19pvmpelihpsr6h3"
            ]
          }
        ],
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSSpeechRecognitionUsageDescription": "Autoriser Sillage à utiliser la reconnaissance vocale."
      }
    },
    "android": {
      "package": "com.sillage.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#7C3AED",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF8F5",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#1F1A2E"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "ndkVersion": "27.0.12077973"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Autoriser Sillage à utiliser votre appareil photo pour scanner les flacons de parfum."
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-asset",
      "expo-image",
      "expo-status-bar",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Autoriser Sillage à utiliser le micro pour rechercher des parfums à la voix.",
          "speechRecognitionPermission": "Autoriser Sillage à utiliser la reconnaissance vocale."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Sillage utilise ta position pour afficher la météo locale et suggérer des parfums adaptés à la saison."
        }
      ],
      "expo-audio",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "sounds": []
        }
      ],
      "expo-localization"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "31e344db-f4ac-4304-b0c9-b4b35059c8e7"
      }
    },
    "owner": "breakloopstudio"
  }
}
