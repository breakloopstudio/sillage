# ─── Supabase ────────────────────────────────────────────────────────────────
# URL du projet Supabase (Dashboard → Settings → API)
EXPO_PUBLIC_SUPABASE_URL=
# Clé anon publique (Dashboard → Settings → API → Project API keys)
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Flag de migration (true = Supabase actif)
EXPO_PUBLIC_USE_SUPABASE=true

# ─── Scripts d'import / migration (jamais dans l'app) ────────────────────────
# Clé service_role (Dashboard → Settings → API → service_role key)
SUPABASE_SERVICE_ROLE_KEY=
# Mode local uniquement (supabase start) : clé service_role de l'instance locale
# (`supabase status`). Utilisée par import-fresh/diff-brands/backfills sans --target=cloud.
SUPABASE_LOCAL_SERVICE_ROLE=

# ─── Scraping Fragrantica (optionnel) ────────────────────────────────────────
# Proxy pour les scripts scrape-*/diff-brands (résidentiel rotatif recommandé :
# Webshare, Smartproxy, Bright Data…). Format : http://[user:pass@]host:port
# Laisser vide = connexion directe depuis votre IP.
SCRAPER_PROXY=

# ─── Google Sign-In ──────────────────────────────────────────────────────────
# Obtiens les client IDs depuis Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# iOS (type iOS) :
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Web (type OAuth Client ID « Web application ») — REQUIS pour Android (ID token) :
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# ─── Mode local Supabase (optionnel) ─────────────────────────────────────────
# true = l'app se connecte à l'instance locale (supabase start) au lieu du cloud
EXPO_PUBLIC_USE_SUPABASE_LOCAL=false

# ─── Génération d'images de notes (optionnel, scripts/images) ────────────────
# DashScope (Alibaba Cloud Model Studio) pour generate-note-images.ts
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
